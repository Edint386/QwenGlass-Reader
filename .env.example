# glassreader 配置（set -a; . ./.env; set +a 后运行 glassreader serve）
# 平台 MCP 插件的 Bearer Token；不填每次启动随机生成，平台插件会失效
READER_TOKEN=
# 页图地址里的随机段（眼镜发不了请求头，靠它鉴权）；只用字母、数字、- 和 _
READER_KEY=
# 眼镜和平台访问的公网根地址，可带路径前缀（反代剥掉前缀后转发）
READER_PUBLIC_URL=https://cast.example.com/reader
# TXT 书库目录（递归收集 *.txt）
READER_BOOKS_DIR=~/Books
# 进度文件
READER_STATE_FILE=~/Library/Application Support/glassreader/progress.json
READER_HOST=127.0.0.1
READER_PORT=8780
# 真机前滑 / 后滑方向与预期相反时设成 1
READER_SWAP_SWIPE=0
